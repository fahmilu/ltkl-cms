        "/api/collections": {
            "get": {
                "tags": [
                    "Collections"
                ],
                "summary": "Get all collections | to see the `type` please execute all the collections first",
                "operationId": "getCollectionsList",
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "description": "Filter type",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Collection listed"
                    }
                }
            }
        },
